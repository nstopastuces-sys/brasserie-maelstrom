---
// Gabarit commun : <head> SEO, polices auto-hébergées, en-tête, pied de page,
// bannière d'âge, grain et curseur.
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgeGate from '../components/AgeGate.astro';
import { withBase } from '../scripts/paths';

interface Props {
  title: string;
  description: string;
  /** Couleurs initiales (bière affichée au premier rendu). */
  theme?: { beer: string; deep: string; accent: string; fg: string };
}

const { title, description, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Démo : aucune page indexée tant que la brasserie n'a pas validé le site.
// Au lancement, construire avec PUBLIC_INDEXABLE=true (et retirer X-Robots-Tag de netlify.toml).
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const themeStyle = theme
  ? `--beer:${theme.beer};--deep:${theme.deep};--accent:${theme.accent};--fg:${theme.fg}`
  : undefined;
---
<!doctype html>
<html lang="fr" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={theme?.beer ?? '#0f0e0c'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Brasserie Maelström" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/og-image.jpg'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <AgeGate />
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"><span class="cursor__label">Glisse</span></div>
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
