---
// Sprite SVG des ingrédients illustrés. Chaque symbole utilise deux variables CSS :
// --ing-fill (aplat) et --ing-stroke (trait), fixées par le carrousel selon la bière.

// Cône de houblon : rangées de bractées pointues, dessinées du bas vers le haut
// pour que chaque rangée recouvre la base de la suivante.
const rows: [number, number[], number, number][] = [
  // [y, centres x, demi-largeur, hauteur]
  [78, [50], 7, 14],
  [68, [43, 57], 9, 16],
  [56, [36, 50, 64], 11, 18],
  [44, [33, 50, 67], 12, 20],
  [32, [36, 50, 64], 11, 20],
  [22, [43, 57], 9, 18],
];
const bract = (cx: number, y: number, w: number, h: number) =>
  `M${cx - w} ${y}C${cx - w} ${y + h * 0.62} ${cx - w * 0.3} ${y + h * 0.92} ${cx} ${y + h}` +
  `C${cx + w * 0.3} ${y + h * 0.92} ${cx + w} ${y + h * 0.62} ${cx + w} ${y}` +
  `C${cx + w * 0.4} ${y - 3} ${cx - w * 0.4} ${y - 3} ${cx - w} ${y}Z`;
const bracts = rows.flatMap(([y, xs, w, h]) => xs.map((x) => ({ d: bract(x, y, w, h), x, y, h })));

// Épi (blé / orge) : grains alternés le long d'une tige.
const grains = Array.from({ length: 6 }, (_, i) => 24 + i * 10);
---
<svg class="ing-sprite" aria-hidden="true" width="0" height="0" style="position:absolute">
  <defs>
    <symbol id="ing-hop" viewBox="0 0 100 100">
      <path d="M50 22C51 14 49 9 53 3" fill="none" />
      <path d="M52 12C60 2 78 2 88 10C80 18 62 20 52 12Z" />
      <path d="M54 12C64 9 74 9 84 10" fill="none" />
      {bracts.map((b) => (
        <g>
          <path d={b.d} />
          <path d={`M${b.x} ${b.y + 2}V${b.y + b.h * 0.7}`} fill="none" />
        </g>
      ))}
    </symbol>

    <symbol id="ing-wheat" viewBox="0 0 100 100">
      <path d="M50 98C49 70 50 40 50 14" fill="none" />
      {grains.map((y) => (
        <g>
          <ellipse cx="42" cy={y} rx="6" ry="9.5" transform={`rotate(-28 42 ${y})`} />
          <ellipse cx="58" cy={y} rx="6" ry="9.5" transform={`rotate(28 58 ${y})`} />
        </g>
      ))}
      <ellipse cx="50" cy="14" rx="5.5" ry="9" />
      <path d="M50 5V-6M40 16L33 4M60 16L67 4" fill="none" />
    </symbol>

    <symbol id="ing-barley" viewBox="0 0 100 100">
      <path d="M50 98C50 72 50 46 50 22" fill="none" />
      {grains.map((y) => (
        <g>
          <ellipse cx="44" cy={y + 4} rx="5" ry="8.5" transform={`rotate(-18 44 ${y + 4})`} />
          <ellipse cx="56" cy={y + 4} rx="5" ry="8.5" transform={`rotate(18 56 ${y + 4})`} />
          <path d={`M41 ${y - 3}L22 ${y - 30}M59 ${y - 3}L78 ${y - 30}`} fill="none" />
        </g>
      ))}
      <ellipse cx="50" cy="20" rx="4.5" ry="8" />
      <path d="M50 12V-12" fill="none" />
    </symbol>

    <symbol id="ing-grain" viewBox="0 0 100 100">
      <g transform="rotate(-24 36 40)">
        <ellipse cx="36" cy="40" rx="17" ry="25" />
        <path d="M36 18C30 30 42 50 36 62" fill="none" />
      </g>
      <g transform="rotate(30 66 62)">
        <ellipse cx="66" cy="62" rx="15" ry="22" />
        <path d="M66 43C61 54 71 70 66 81" fill="none" />
      </g>
      <g transform="rotate(70 68 22)">
        <ellipse cx="68" cy="22" rx="9" ry="13" />
        <path d="M68 11C65 18 71 26 68 33" fill="none" />
      </g>
    </symbol>

    <symbol id="ing-pear" viewBox="0 0 100 100">
      <path d="M50 20C43 20 42 31 39 39C28 47 22 59 25 72C28 87 40 95 50 95C60 95 72 87 75 72C78 59 72 47 61 39C58 31 57 20 50 20Z" />
      <path d="M50 21C50 13 52 9 56 5" fill="none" />
      <path d="M54 12C61 4 73 5 77 10C70 17 60 17 54 12Z" />
      <path d="M37 62C35 70 38 78 44 83" fill="none" />
    </symbol>

    <symbol id="ing-caramel" viewBox="0 0 100 100">
      <path d="M30 50L10 34L14 50L10 66Z" />
      <path d="M70 50L90 34L86 50L90 66Z" />
      <rect x="28" y="34" width="44" height="32" rx="14" />
      <path d="M38 42C46 40 54 40 62 42M38 58C46 60 54 60 62 58" fill="none" />
    </symbol>

    <symbol id="ing-flake" viewBox="0 0 100 100">
      <g fill="none">
        {[0, 60, 120].map((a) => (
          <g transform={`rotate(${a} 50 50)`}>
            <path d="M50 8V92" />
            <path d="M50 22L40 12M50 22L60 12M50 78L40 88M50 78L60 88" />
            <path d="M50 36L42 28M50 36L58 28M50 64L42 72M50 64L58 72" />
          </g>
        ))}
      </g>
    </symbol>
  </defs>
</svg>
