---
// En-tête minimal : logo texte, menu, bouton « Espace pros ».
import { withBase } from '../scripts/paths';

const links = [
  { href: withBase('/#la-gamme'), label: 'Nos bières' },
  { href: withBase('/#portes-ouvertes'), label: 'Portes ouvertes' },
  { href: withBase('/#brasserie'), label: 'La brasserie' },
  { href: withBase('/#contact'), label: 'Contact' },
];
---
<header class="site-header" data-header>
  <a class="brand" href={withBase('/')} aria-label="Brasserie Maelström, accueil">
    <span class="brand__small">Brasserie</span>
    <span class="brand__name">Maelström</span>
  </a>

  <nav class="nav" id="menu" aria-label="Navigation principale">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <a class="btn header-pros" href={withBase('/#pros')}>Espace pros</a>

  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu">
    <span class="sr-only">Menu</span>
    <span class="nav-toggle__bar"></span>
    <span class="nav-toggle__bar"></span>
  </button>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding: 18px var(--gutter);
    color: var(--fg);
    transition: color 0.5s, background-color 0.4s, padding 0.4s var(--ease-out);
  }
  .site-header.is-scrolled {
    color: var(--paper);
    background: rgb(15 14 12 / 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding-block: 12px;
  }

  .brand {
    display: grid;
    line-height: 1;
    text-decoration: none;
    margin-right: auto;
  }
  .brand__small {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .brand__name {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav ul {
    display: flex;
    gap: clamp(14px, 2.2vw, 32px);
  }
  .nav a {
    position: relative;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* bouton en couleurs inversées : fond = texte du hero, texte = couleur de la bière */
  .header-pros {
    padding: 0.7em 1.2em;
    color: var(--beer);
    background: var(--fg);
  }
  .site-header.is-scrolled .header-pros {
    background: var(--beer);
    color: var(--fg);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
    padding: 12px 10px;
    flex-direction: column;
    justify-content: space-between;
  }
  .nav-toggle__bar {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:first-of-type {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:last-of-type {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
      height: 36px;
      padding: 10px 8px;
    }
    .header-pros {
      font-size: 0.82rem;
    }
    .nav {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: grid;
      place-items: center;
      background: var(--ink);
      color: var(--paper);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s, visibility 0.4s;
    }
    .nav ul {
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .nav a {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(2.2rem, 11vw, 3.4rem);
      text-transform: uppercase;
    }
    .site-header.is-open .nav {
      opacity: 1;
      visibility: visible;
    }
    .site-header.is-open {
      color: var(--paper);
    }
  }
</style>
