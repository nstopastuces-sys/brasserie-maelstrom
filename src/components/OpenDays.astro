---
// Bandeau « Prochaine porte ouverte ». Démo : date à confirmer avec la brasserie.
const words = ['Portes ouvertes', 'Visite de la brasserie', 'Rencontre avec les brasseurs', 'Brassée à la Mandallaz'];
---
<section class="open" id="portes-ouvertes" aria-labelledby="open-title">
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <span class="marquee__group">
          {words.map((w) => <span>{w}<i>✦</i></span>)}
        </span>
      ))}
    </div>
  </div>

  <div class="open__card">
    <div class="open__date" aria-hidden="true">
      <span class="open__month">Printemps</span>
      <span class="open__year">2027</span>
    </div>
    <div class="open__body">
      <p class="kicker">Prochaine porte ouverte</p>
      <h2 class="open__title" id="open-title">Viens voir où ça se passe.</h2>
      <p class="open__text">
        Deux à trois fois par an, on ouvre les portes de la brasserie : visite des cuves,
        rencontre avec l'équipe, et toute la gamme à découvrir sur place.
        <span class="open__todo">Date et programme à confirmer.</span>
      </p>
    </div>
    <div class="open__actions">
      <a class="btn btn--beer" href="#portes-ouvertes">
        Préviens-moi
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <span class="open__hint">Ajout au calendrier (.ics) dès que la date tombe</span>
    </div>
  </div>
</section>

<style>
  .open {
    padding: clamp(40px, 6vw, 70px) 0 clamp(60px, 8vw, 110px);
    overflow: hidden;
  }
  .marquee {
    overflow: hidden;
    padding: 18px 0;
    background: var(--beer);
    color: var(--fg);
    transform: rotate(-1.6deg);
    margin: 0 -2vw clamp(44px, 6vw, 80px);
    transition: background-color 0.6s, color 0.6s;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }
  .marquee__group {
    display: flex;
    flex: none;
  }
  .marquee span span {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    line-height: 1;
    white-space: nowrap;
  }
  .marquee i {
    font-style: normal;
    padding: 0 0.5em;
    opacity: 0.6;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .open__card {
    margin: 0 var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--ink-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .open__date {
    display: grid;
    place-items: center;
    width: clamp(120px, 14vw, 170px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    text-align: center;
    line-height: 0.95;
  }
  .open__month {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    align-self: end;
  }
  .open__year {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    align-self: start;
  }
  .open .kicker {
    color: var(--beer);
    margin-bottom: 10px;
    transition: color 0.6s;
  }
  .open__title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 0.95;
    margin-bottom: 14px;
  }
  .open__text {
    color: var(--paper-dim);
    max-width: 56ch;
  }
  .open__todo {
    font-style: italic;
  }
  .open__actions {
    display: grid;
    justify-items: start;
    gap: 10px;
  }
  .open__hint {
    font-size: 0.8rem;
    color: var(--paper-dim);
    max-width: 22ch;
  }
  @media (max-width: 900px) {
    .open__card {
      grid-template-columns: 1fr;
    }
  }
</style>
