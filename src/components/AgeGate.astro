---
// Confirmation d'âge à la première visite. Affichée uniquement par JavaScript :
// le contenu reste dans le HTML pour les moteurs de recherche.
---
<div class="age-gate" role="dialog" aria-modal="true" aria-labelledby="age-title" hidden data-age-gate>
  <div class="age-gate__card">
    <p class="kicker">Brasserie Maelström</p>
    <h2 id="age-title" class="age-gate__title">Tu as 18 ans ou plus&nbsp;?</h2>
    <p class="age-gate__text" data-age-text>
      Ce site parle de bière : il est réservé aux personnes majeures.
    </p>
    <div class="age-gate__actions">
      <button class="btn btn--beer" type="button" data-age-yes>J'ai 18 ans ou plus</button>
      <button class="btn btn--ghost" type="button" data-age-no>Non</button>
    </div>
  </div>
</div>

<style>
  .age-gate {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: rgb(15 14 12 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .age-gate[hidden] {
    display: none;
  }
  .age-gate__card {
    width: min(460px, 100%);
    padding: clamp(24px, 5vw, 40px);
    border-radius: var(--radius);
    background: var(--ink-2);
    color: var(--paper);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
    display: grid;
    gap: 14px;
  }
  .age-gate .kicker {
    color: var(--beer);
  }
  .age-gate__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 7vw, 2.8rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .age-gate__text {
    color: var(--paper-dim);
  }
  .age-gate__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
</style>
